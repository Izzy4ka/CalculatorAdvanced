<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_background"
    tools:context=".ui.fragment.CalculatorFragment">

    <ImageView
        android:id="@+id/btn_minimize"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF"
        tools:ignore="MissingPrefix" />

    <TextView
        android:id="@+id/tv_calculator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Калькулятор"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btn_minimize"
        app:layout_constraintEnd_toStartOf="@+id/tv_converter"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_minimize" />

    <TextView
        android:id="@+id/tv_converter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Конвертер"
        android:textColor="#666666"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_minimize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_calculator"
        app:layout_constraintTop_toTopOf="@+id/btn_minimize" />

    <ImageView
        android:id="@+id/btn_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_history"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:stackFromEnd="true"
        tools:itemCount="3"
        app:layout_constraintBottom_toTopOf="@+id/tv_result"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_minimize"
        tools:listitem="@layout/item_calculate"
        />

    <TextView
        android:id="@+id/tv_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="bottom|end"
        android:includeFontPadding="false"
        android:layout_marginEnd="0dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="72sp"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_flow"
        app:layout_constraintEnd_toEndOf="@+id/keyboard_flow"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/keyboard_flow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="btn_2nd,btn_deg,btn_sin,btn_cos,btn_tan,btn_pow,btn_lg,btn_ln,btn_open,btn_close,btn_sqrt,btn_ac,btn_del,btn_percent,btn_divide,btn_fact,btn_7,btn_8,btn_9,btn_multiply,btn_inv,btn_4,btn_5,btn_6,btn_minus,btn_pi,btn_1,btn_2,btn_3,btn_plus,btn_expand,btn_e,btn_0,btn_comma,btn_equals"
        app:flow_maxElementsWrap="4"
        app:flow_verticalGap="8dp"
        app:flow_horizontalGap="0dp"
        app:flow_wrapMode="aligned"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_scientific"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="
            btn_2nd, btn_deg, btn_sin, btn_cos, btn_tan,
            btn_pow, btn_lg, btn_ln, btn_open, btn_close,
            btn_sqrt, btn_fact, btn_inv, btn_pi, btn_e" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_2nd"
        style="@style/CalcButton"
        android:text="2nd" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_deg"
        style="@style/CalcButton"
        android:text="deg" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sin"
        style="@style/CalcButton"
        android:text="sin" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cos"
        style="@style/CalcButton"
        android:text="cos" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_tan"
        style="@style/CalcButton"
        android:text="tan" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pow"
        style="@style/CalcButton"
        android:text="xʸ" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_lg"
        style="@style/CalcButton"
        android:text="lg" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ln"
        style="@style/CalcButton"
        android:text="ln" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open"
        style="@style/CalcButton"
        android:text="(" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close"
        style="@style/CalcButton"
        android:text=")" />

    <!-- Строка 3 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sqrt"
        style="@style/CalcButton"
        android:text="√x" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ac"
        style="@style/CalcButton"
        android:text="AC"
        android:textColor="#FF9800" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_del"
        style="@style/CalcButton"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="#FF9800" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_percent"
        style="@style/CalcButton"
        android:text="%"
        android:textColor="#FF9800" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_divide"
        style="@style/CalcButton"
        android:text="÷"
        android:textColor="#FF9800"
        android:textSize="28sp" />

    <!-- Строка 4 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_fact"
        style="@style/CalcButton"
        android:text="x!" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_7"
        style="@style/CalcButton"
        android:text="7"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_8"
        style="@style/CalcButton"
        android:text="8"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_9"
        style="@style/CalcButton"
        android:text="9"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_multiply"
        style="@style/CalcButton"
        android:text="×"
        android:textColor="#FF9800"
        android:textSize="28sp" />

    <!-- Строка 5 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_inv"
        style="@style/CalcButton"
        android:text="1/x" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_4"
        style="@style/CalcButton"
        android:text="4"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_5"
        style="@style/CalcButton"
        android:text="5"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_6"
        style="@style/CalcButton"
        android:text="6"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_minus"
        style="@style/CalcButton"
        android:text="−"
        android:textColor="#FF9800"
        android:textSize="28sp" />

    <!-- Строка 6 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pi"
        style="@style/CalcButton"
        android:text="π" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_1"
        style="@style/CalcButton"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_2"
        style="@style/CalcButton"
        android:text="2"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_3"
        style="@style/CalcButton"
        android:text="3"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_plus"
        style="@style/CalcButton"
        android:text="+"
        android:textColor="#FF9800"
        android:textSize="28sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_expand"
        style="@style/CalcButton"
        app:iconGravity="textStart"
        app:icon="@drawable/ic_transform"
        app:iconPadding="0dp"
        app:iconTint="#FF9800" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_e"
        style="@style/CalcButton"
        android:text="e" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_0"
        style="@style/CalcButton"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_comma"
        style="@style/CalcButton"
        android:text=","
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_equals"
        style="@style/CalcButton"
        android:text="="
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        app:backgroundTint="#FF9800" />
</androidx.constraintlayout.widget.ConstraintLayout>