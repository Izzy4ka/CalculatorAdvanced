<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Calculator" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="Theme.Calculator" parent="Base.Theme.Calculator" />

    <style name="ShapeAppearance.Calculator.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.App.CalculatorButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>

        <item name="android:textColor">@color/calc_text_color</item>
        <item name="android:textSize">@dimen/calc_btn_text_size</item>
        <item name="android:backgroundTint">@color/calc_btn_dark_gray</item>

        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Calculator.Circle</item>
    </style>

    <style name="Widget.App.CalculatorButton.FirstLine" parent="Widget.App.CalculatorButton">
        <item name="android:textColor">@color/calc_btn_dark_gray</item>
        <item name="android:backgroundTint">@color/calc_btn_white_gray</item>
    </style>

    <style name="Widget.App.CalculatorButton.Operation" parent="Widget.App.CalculatorButton">
        <item name="android:textColor">@color/black</item>
        <item name="android:backgroundTint">@color/calc_btn_orange</item>
    </style>
</resources>